{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    ":automergeMinor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":disableRateLimiting",
    ":semanticCommits",
    ":semanticCommitScopeDisabled",
    ":semanticCommitTypeAll(deps)"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "Security fixes",
    "addLabels": ["security"]
  },
  "dependencyDashboard": true,
  "schedule": ["* 14 * * 1,4"],
  "packageRules": [
    {
      "matchManagers": ["pep621", "pep723"],
      "groupName": "Python dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true
    },
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust dependencies"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "TS dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["src/pyapp/\\.env\\.template$"],
      "matchStrings": ["PYAPP_UV_VERSION\\s*=\\s*(?<currentValue>.*)"],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "groupName": "uv"
    }
  ],
  "npm": {
    "rangeStrategy": "pin"
  }
}
